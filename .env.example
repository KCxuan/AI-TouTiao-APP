# 复制为项目根目录的 .env 后填写真实值，不要提交 .env。

# OpenAI 兼容接口（DeepSeek 等）。不填则新闻浏览仍可用，AI 接口会失败。
LLM_API_KEY=your_llm_api_key
LLM_MODEL_ID=your_model_id
LLM_BASE_URL=https://api.example.com/v1

# 站外新闻搜索。不填则深度研究无法补站外来源。
TAVILY_API_KEY=your_tavily_api_key

# MySQL（与 database.sql 中的库名一致）
# 本机开发保持 127.0.0.1。docker compose 会在容器内覆盖为 mysql，不必改本文件。
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=news_app

# Redis
# 本机开发保持 localhost。docker compose 会在容器内覆盖为 redis。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 可选。逗号分隔的前端源。不填则默认放行 Vite 5173/5174。
# Docker 下一页和接口同源，通常不必改。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选。浏览器访问端口，默认 80。被占用时改为 8080。
# WEB_PORT=80
